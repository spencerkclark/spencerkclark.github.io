---
const { journals } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {journals.sort((a, b) => a.name.localeCompare(b.name)).map((journal) => (
    <a 
    href={journal.url} 
    target="_blank" 
    class="px-3 py-1.5 border border-base-content/10 bg-base-content/5 rounded-md text-sm text-base-content/80 hover:border-primary/40 hover:text-primary hover:bg-primary/5 transition-all text-center"
    >
    {journal.name}
    </a>
  ))}
</div>
