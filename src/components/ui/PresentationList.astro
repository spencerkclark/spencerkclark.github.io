---
const { items } = Astro.props;

// 1. First, sort the entire array by absolute date (Month + Year)
const chronologicallySorted = [...items].sort((a, b) => {
  // We assume date is "Oct 2024" or "January 2024"
  // Adding "1, " helps JS parse the string reliably as a Date object
  const dateA = new Date(`1, ${a.date}`).getTime();
  const dateB = new Date(`1, ${b.date}`).getTime();
  return dateB - dateA; // Newest first
});

// 2. Group the already-sorted items by year
const grouped = chronologicallySorted.reduce((acc, item) => {
  // Extract year from the date string if 'year' property isn't explicitly provided
  // or use item.year if your data structure already has it.
  const year = item.year || new Date(`1, ${item.date}`).getFullYear().toString();
  
  if (!acc[year]) acc[year] = [];
  acc[year].push(item);
  return acc;
}, {});

// 3. Get the years in descending order
const years = Object.keys(grouped).sort((a, b) => b - a);

const MY_NAME = "Clark, S. K."; 
---

<div class="space-y-10">
  {years.map((year) => (
    <section>
      <div class="flex items-center gap-4 mb-4">
        <h2 class="text-med font-bold text-primary/80">{year}</h2>
        <div class="h-[1px] flex-1 bg-base-content/5"></div>
      </div>

      <ul class="space-y-6">
        {grouped[year].map((talk) => {
          const displayAuthors = talk.authors.replace(
            MY_NAME,
            `<span class="font-bold text-base-content underline">${MY_NAME}</span>`
          );

          return (
            <li class="grid grid-cols-1 md:grid-cols-12 gap-4 text-sm border-l-2 border-transparent hover:border-primary/30 pl-4 transition-colors">
              <div class="md:col-span-10 leading-relaxed text-base-content/90">
                <span set:html={displayAuthors} />
                <span> ({talk.date}).</span>
                <span class="font-semibold text-base-content"> {talk.title}.</span>
                <span class="italic"> {talk.conference}</span>, {talk.location}.
              </div>

              <div class="md:col-span-2 flex md:justify-end items-start pt-1">
                <span class={`text-[10px] font-bold uppercase tracking-widest px-2.5 py-0.5 rounded-full border leading-tight ${
                  talk.type === 'Talk' 
                  ? 'border-primary/30 text-primary bg-primary/5' 
                  : 'border-base-content/20 text-base-content/60 bg-base-content/5'
                }`}>
                  {talk.type}
                </span>
              </div>
            </li>
          )
        })}
      </ul>
    </section>
  ))}
</div>
