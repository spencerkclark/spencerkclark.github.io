---
import { Image } from 'astro:assets'
import { marked } from 'marked';

import SocialIcons from './SocialIcons.astro'


const {about, fullName, title, institute, profilePicture} = Astro.props
---
<div class='flex-1'>
  <h1 class='text-3xl font-black mb-4'>
    About
  </h1>
  <!-- <p class='text-xl text-gray-600 mb-4'>{title}{institute ? ` at ${institute}` : ''}</p> -->
  <p class='text-lg mb-6 prose-inline'>
    <span set:html={marked.parseInline(about)}
  </p>
  <div class='flex gap-4'>
    <SocialIcons />
  </div>
</div>
