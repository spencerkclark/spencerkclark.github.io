---
import { marked } from 'marked';

const { contributions } = Astro.props;
---

<div class="space-y-8">
  {contributions.map((project) => (
    <div class="group">
      <div class="flex flex-col md:flex-row md:justify-between md:items-baseline gap-2">
        <h3 class="text-lg font-bold text-base-content">
          <a href={project.repoUrl} target="_blank" class="hover:text-primary transition-colors flex items-center gap-2">
            {project.title}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
          </a>
        </h3>
        <span class="text-[10px] font-bold uppercase tracking-widest text-primary/80 bg-primary/5 border border-primary/20 px-2.5 py-0.5 rounded-full leading-tight">
          {project.role}
        </span>
      </div>
      
      <p class="text-sm text-base-content/70 mt-1 mb-3 italic">
        {project.description}
      </p>

      <ul class="list-disc list-outside ml-5 space-y-1">
        {project.highlights.map((point) => (
          <li class="text-sm text-base-content/90 leading-relaxed prose-inline">
            {/* The set:html directive renders the Markdown as HTML */}
            <span set:html={marked.parseInline(point)} />
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
