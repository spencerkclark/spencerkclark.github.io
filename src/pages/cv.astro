---
import Layout from '@/layouts/Layout.astro'
import { experiences, education, skills, softwareContributions, presentations, reviewService, awards, teaching } from '../data/cv'
import CvTimeline from '@/components/ui/CvTimeline.astro'
import SoftwareList from '@/components/ui/SoftwareList.astro';
import PresentationList from '@/components/ui/PresentationList.astro';
import ReviewList from '@/components/ui/ReviewList.astro';
import DownloadCV from '@/components/ui/DownloadCV.astro';
import AwardList from '@/components/ui/AwardList.astro';

import { getBibPublications } from '../lib/bibUtils.ts';

// Path to your bib file (e.g., in src/content/my_papers.bib)
const publications = getBibPublications('./src/content/my_papers.bib');

import type { Experience, Education, Publication } from '../types/cv'
import List from '@/components/ui/List.astro'
import PublicationsList from '@/components/ui/PublicationsList.astro'

let orderedExperiences: Experience[] = []
let orderedEducations: Education[] = []
let orderedPublications: Publication[] = []

const orderElement = <T extends { time: string }>(a: T, b: T) => {
  const presentValues = ['present', 'now', 'current', 'today']
  if (
			presentValues.includes(
				(a['time'] as string)?.split(' - ')[1]?.toLowerCase()
			)
		) {
			// If the date is 'present', it should be the first element
			return -1
		}
		const dateA = new Date((a['time'] as string)?.split(' - ')[1])
		const dateB = new Date((b['time'] as string)?.split(' - ')[1])
		return dateB.getTime() - dateA.getTime()
}

if (experiences.length > 0) {
	orderedExperiences = experiences.sort((a, b) => {
		return orderElement(a, b)
	})
}

if (education.length > 0) {
	orderedEducations = education.sort((a, b) => {
		return orderElement(a, b)
	})
}

if (publications.length > 0) {
	orderedPublications = publications.sort((a, b) => {
		return orderElement(a, b)
	})
}

// Helper to map teaching data to timeline expectations if keys differ
const teachingForTimeline = teaching.map(t => ({
  time: t.date,
  title: t.title,
  school: t.institution, // Maps 'institution' to 'school' for the component
  location: t.course,    // Uses the course name in the location slot
  description: t.description,
  logo: t.logo,
}));
---

<Layout>
	<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4 border-base-content/10 pb-8">
	<div>
		<h1 class="text-3xl font-black">Curriculum Vitae</h1>
		<p class="text-base-content/60 mt-1">Last updated: December 2025</p>
	</div>
	
	<DownloadCV href="/CV.pdf" fileName="CV.pdf" />
	</div>

	{
		orderedEducations.length > 0 && (
			<section class='mb-12'>
				<h2 class='text-2xl font-bold mb-6 border-b pb-2'>
					Education
				</h2>
				<CvTimeline elements={orderedEducations} colored={false} />
			</section>
		)
	}

	{
		orderedExperiences.length > 0 && (
			<section class='mb-12'>
				<h2 class='text-2xl font-bold mb-6 border-b pb-2'>
					Experience
				</h2>
				<CvTimeline elements={orderedExperiences} colored={false} />
			</section>
		)
	}

	{
		orderedPublications.length > 0 && (
			<section class='mb-12'>
				<h2 class='text-2xl font-bold mb-6 border-b pb-2'>
					Publications
				</h2>
				<PublicationsList elements={orderedPublications}/>
			</section>
		)
	}

	<section class="mb-12">
		<h2 class="text-2xl font-bold mb-6 border-b pb-2">Presentations</h2>
		<PresentationList items={presentations} />
	</section>

	<section class="mb-12">
		<h2 class="text-2xl font-bold mb-6 border-b pb-2">Select open source software contributions</h2>
		<SoftwareList contributions={softwareContributions} />
	</section>

	<section class="mb-12">
		<h2 class="text-2xl font-bold mb-6 border-b pb-2">Teaching experience</h2>
		<CvTimeline elements={teachingForTimeline} colored={false} />
	</section>

	<section class="mb-12">
		<h2 class="text-2xl font-bold mb-6 border-b pb-2">Reviewing</h2>
		<p class="text-sm text-base-content/60 mb-4">
			Peer-reviewed manuscripts for:
		</p>
		<ReviewList journals={reviewService} />
	</section>

	<section class="mb-12">
		<h2 class="text-2xl font-bold mb-6 border-b pb-2">Select honors and awards</h2>
		<AwardList items={awards} />
	</section>
</Layout>
